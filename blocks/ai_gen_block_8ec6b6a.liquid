      }
    });
  }

  // The popover is moved to <body> while open so that it floats above every
  // section (sections create their own stacking contexts), then moved back.
  function place(li, pop) {
    var r = li.getBoundingClientRect();
    var top = r.bottom + 8;
    var mobile = window.innerWidth < 750;
    if (mobile) {
      pop.style.width = (window.innerWidth - 24) + 'px';
      pop.style.left = '12px';
    } else {
      pop.style.width = '';
      var w = pop.offsetWidth;
      pop.style.left = Math.max(8, Math.min(r.left - 8, window.innerWidth - 8 - w)) + 'px';
    }
    pop.style.top = top + 'px';
    pop.style.maxHeight = Math.max(160, window.innerHeight - top - 12) + 'px';
