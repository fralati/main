            '<span>' + esc(shortTitle(p.title, pre, isColor)) + '</span></a>';
        });
        grid.innerHTML = html;
        state.hidden = true;
        if (pop._ccbcLi) place(pop._ccbcLi, pop);
        var cur = grid.querySelector('.is-current'); if (cur) cur.scrollIntoView({ block: 'nearest' });
      })
      .catch(function () { state.textContent = '—'; pop.dataset.loaded = ''; });
  }

  function setupContext(nav) {
    var page = nav.getAttribute('data-page');
    var enabled = nav.getAttribute('data-context') === 'true';
    if (page === 'collection' && nav.getAttribute('data-col-handle')) {
      writeCtx({ h: nav.getAttribute('data-col-handle'), t: nav.getAttribute('data-col-title'), u: nav.getAttribute('data-col-url') });
      return;
    }
    if (page !== 'product' || !enabled) return;
    var slot = nav.querySelector('[data-ccbc-ctx]'); if (!slot) return;
    // Only when there is a reason: the visitor navigated here from within the shop.
    var ref = document.referrer || '';
    if (ref.indexOf(location.origin + '/') !== 0) return;
    var ctx = readCtx(); if (!ctx || !ctx.h) return;
    var handles = ',' + (nav.getAttribute('data-handles') || '') ;
    var canon = ',' + (nav.getAttribute('data-canon') || '');
    if (handles.indexOf(',' + ctx.h + ',') === -1) return;     // not a collection of this product
    if (canon.indexOf(',' + ctx.h + ',') !== -1) return;       // already in the canonical path
    var title = (ctx.t || '').trim();
    var pre = (nav.getAttribute('data-fn-prefix') || '').trim();
    if (pre && title.indexOf(pre + ' ') === 0) title = title.slice(pre.length + 1);
    title = title.replace(/ Collection$/, '').trim();
    if (!title) return;
    // rebuild the URL in the current language (the stored one may come from another locale)
    var colBase = nav.getAttribute('data-collections-url') || '/collections';
    slot.querySelector('a').setAttribute('href', colBase.replace(/\/$/, '') + '/' + ctx.h);
    slot.querySelector('[data-ccbc-ctx-title]').textContent = title;
    slot.hidden = false;
  }

  function setupSticky(nav) {
    if (nav.getAttribute('data-sticky') !== 'true' || nav.dataset.stickyDone) return;
    if (!('IntersectionObserver' in window)) return;
    nav.dataset.stickyDone = '1';
    document.querySelectorAll('.ccbc-sticky').forEach(function (b) { b.remove(); });
    var bar = document.createElement('div');
    bar.className = 'ccbc-sticky';
    bar.setAttribute('aria-hidden', 'true');
    var inner = document.createElement('div'); inner.className = 'ccbc-sticky__in';
    var parts = [];
    nav.querySelectorAll('.ccbc__list > li:not(.ccbc__item--ctx)').forEach(function (li) {
      var a = li.querySelector(':scope > .ccbc__link');
      var c = li.querySelector('.ccbc__current');
      if (a) parts.push('<a href="' + esc(a.getAttribute('href')) + '">' + esc(a.textContent.trim()) + '</a>');
      else if (c) parts.push('<strong>' + esc(c.textContent.trim()) + '</strong>');
    });
    var sep = nav.querySelector('.ccbc__sep'); var sepHtml = sep ? '<span class="ccbc__sep">' + sep.innerHTML + '</span>' : ' / ';
    inner.innerHTML = parts.join(sepHtml);
    bar.appendChild(inner);
    document.body.appendChild(bar);
    var header = document.getElementById('header-component');
    var stickyMode = header ? header.getAttribute('sticky') : null;
    bar.style.setProperty('--ccbc-sticky-top', stickyMode === 'always' ? 'var(--header-height, 0px)' : '0px');
    bar.style.setProperty('--ccbc-size', getComputedStyle(nav).getPropertyValue('--ccbc-size') || '13px');
    var io = new IntersectionObserver(function (entries) {
      var e = entries[0];
      var above = !e.isIntersecting && e.boundingClientRect.top < 0;
      bar.classList.toggle('is-on', above);
    }, { threshold: 0 });
    io.observe(nav);
  }

  function initNav(nav) {
    if (nav.dataset.ccbcReady) return;
    nav.dataset.ccbcReady = '1';
    setupContext(nav);

    // mobile expand
    var more = nav.querySelector('[data-ccbc-expand]');
    if (more) more.addEventListener('click', function () { nav.removeAttribute('data-collapsed'); more.setAttribute('aria-expanded', 'true'); });

    nav.querySelectorAll('.ccbc__item').forEach(function (li) {
      var btn = li.querySelector(':scope > .ccbc__btn'); if (!btn) return;
      btn.addEventListener('click', function (e) {
        e.preventDefault(); e.stopPropagation();
        li.classList.contains('is-open') ? closeAll() : open(li);
      });
      if (canHover) {
        li.addEventListener('mouseenter', function () { clearTimeout(li._ccbcTimer); li._ccbcTimer = setTimeout(function () { open(li); }, 140); });
        li.addEventListener('mouseleave', function () { clearTimeout(li._ccbcTimer); li._ccbcTimer = setTimeout(function () { if (li.classList.contains('is-open')) closeAll(); }, 260); });
      }
    });

    setupSticky(nav);
  }

  if (!window.__ccbcGlobal) {
    window.__ccbcGlobal = true;
    document.addEventListener('click', function (e) { if (!e.target.closest('[data-ccbc] .ccbc__item.is-open, .ccbc__pop')) closeAll(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(); });
    window.addEventListener('scroll', function () { closeAll(); }, { passive: true });
    window.addEventListener('resize', function () { closeAll(); });
    document.addEventListener('shopify:section:load', function () { window.__ccbcInit(); });
    document.addEventListener('shopify:block:select', function () { window.__ccbcInit(); });
  }

  window.__ccbcInit = function () { document.querySelectorAll('[data-ccbc]').forEach(initNav); };
  window.__ccbcInit();
})();
</script>

{%- endif -%}

