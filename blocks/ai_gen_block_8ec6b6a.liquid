  function readCtx() { try { return JSON.parse(sessionStorage.getItem(KEY) || 'null'); } catch (e) { return null; } }
  function writeCtx(o) { try { sessionStorage.setItem(KEY, JSON.stringify(o)); } catch (e) {} }

  function closeAll(except) {
    document.querySelectorAll('[data-ccbc] .ccbc__item.is-open').forEach(function (li) {
      if (li === except) return;
