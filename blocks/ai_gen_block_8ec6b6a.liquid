    function get(b) { return fetch(b + '/products.json?limit=250', { headers: { 'Accept': 'application/json' } }).then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); }); }
    get(base)
      .catch(function (err) { if (unlocalized !== base) return get(unlocalized); throw err; })
