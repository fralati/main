{% comment %} cliCHair Hair Quiz v5 - PARTE 1 di 2 (stile e struttura). La PARTE 2 va in un secondo blocco Custom Liquid subito sotto. {% endcomment %}
{%- assign cq_lang = request.locale.iso_code | slice: 0, 2 | downcase -%}
<style>
.cq2{--cq-ink:var(--color-foreground,#1a1a1a);--cq-bg:var(--color-background,#ffffff);--cq-acc:#b3202a;--cq-line:color-mix(in srgb,var(--cq-ink) 14%,transparent);--cq-soft:color-mix(in srgb,var(--cq-ink) 5%,transparent);--cq-muted:color-mix(in srgb,var(--cq-ink) 66%,transparent);--cq-hi:rgba(255,255,255,.55);--cq-r:14px;--cq-gap:12px;--cq-h:56px;font-family:var(--font-body--family,system-ui,sans-serif);color:var(--cq-ink);width:100%;box-sizing:border-box}
.cq2 *{box-sizing:border-box}
div:has(>.cq2){width:100%!important;max-width:100%!important;flex:1 1 100%;align-self:stretch}
.cq2 :is(button,summary,textarea):focus{outline:none}
.cq2 :is(button,summary,textarea):focus-visible{outline:2px solid var(--cq-acc);outline-offset:3px}
.cq2-toggle{appearance:none;width:100%;display:flex;align-items:center;gap:16px;padding:20px 2px;border:0;border-top:1px solid var(--cq-line);border-bottom:1px solid var(--cq-line);background:transparent;color:var(--cq-ink);font:inherit;text-align:left;cursor:pointer}
.cq2-ico{width:40px;height:40px;flex:none;border-radius:50%;background:var(--cq-acc);display:grid;place-items:center}
.cq2-tt{flex:1;min-width:0}
.cq2-tt b{display:block;font-family:var(--font-heading--family,inherit);font-weight:700;font-size:clamp(1.05rem,2vw,1.4rem);text-transform:uppercase;letter-spacing:.02em;line-height:1.15}
.cq2-tt small{display:block;font-size:.86rem;color:var(--cq-muted);margin-top:4px;line-height:1.35}
.cq2-cta{flex:none;display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;padding:0 20px 0 22px;border:2px solid var(--cq-acc);border-radius:999px;background:transparent;color:var(--cq-ink);font-weight:600;font-size:.82rem;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;transition:background .2s,color .2s,border-color .2s;animation:cq2Pulse 2.6s ease-out 1s infinite}
.cq2-cta svg{color:var(--cq-acc);transform:rotate(-90deg);transition:transform .4s cubic-bezier(.2,.7,.2,1),color .2s}
@media (hover:hover){.cq2-toggle:hover .cq2-cta{background:var(--cq-acc);color:#fff}.cq2-toggle:hover .cq2-cta svg{color:#fff;transform:rotate(-90deg) translateY(3px)}}
.cq2-toggle:active .cq2-cta{background:var(--cq-acc);color:#fff}
.cq2.open .cq2-cta{background:transparent;color:var(--cq-ink);border-color:var(--cq-ink);border-width:1.5px;animation:none}
.cq2.open .cq2-cta svg{color:var(--cq-ink);transform:rotate(180deg)}
@media (hover:hover){.cq2.open .cq2-toggle:hover .cq2-cta{background:var(--cq-soft);color:var(--cq-ink)}.cq2.open .cq2-toggle:hover .cq2-cta svg{color:var(--cq-ink);transform:rotate(180deg)}}
@keyframes cq2Pulse{0%{box-shadow:0 0 0 0 rgba(179,32,42,.4)}70%{box-shadow:0 0 0 12px rgba(179,32,42,0)}100%{box-shadow:0 0 0 0 rgba(179,32,42,0)}}
.cq2-body{display:grid;grid-template-rows:0fr;transition:grid-template-rows .45s cubic-bezier(.2,.7,.2,1)}
.cq2-body>div{overflow:hidden;min-height:0}
.cq2.open .cq2-body{grid-template-rows:1fr}
.cq2-wrap{max-width:720px;margin:0 auto;padding:32px 0 44px}
.cq2-path{list-style:none;margin:0 0 28px;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:var(--cq-gap)}
.cq2-path li{display:flex;align-items:flex-start;gap:10px;padding-top:12px;border-top:2px solid var(--cq-line);font-size:.8rem;line-height:1.3;color:var(--cq-muted);transition:border-color .3s,color .3s}
.cq2-path span{padding-top:3px}
.cq2-path i{flex:none;width:22px;height:22px;border-radius:50%;border:1.5px solid var(--cq-line);display:grid;place-items:center;font-style:normal;font-size:.72rem;font-weight:700}
.cq2-path li.is-on{color:var(--cq-ink);border-top-color:var(--cq-acc)}
.cq2-path li.is-on i{background:var(--cq-acc);border-color:var(--cq-acc);color:#fff}
.cq2-path li.is-done{border-top-color:var(--cq-ink)}
.cq2-path li.is-done i{background:var(--cq-ink);border-color:var(--cq-ink);color:var(--cq-bg)}
.cq2-in{animation:cq2In .28s cubic-bezier(.2,.7,.2,1) both}
@keyframes cq2In{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.cq2-stage{scroll-margin-top:110px}
.cq2-prog{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:14px;font-size:.76rem;letter-spacing:.06em;text-transform:uppercase;color:var(--cq-muted);margin:0 0 20px}
.cq2-bar{height:3px;background:var(--cq-line);border-radius:3px;overflow:hidden}
.cq2-bar i{display:block;height:100%;background:var(--cq-acc);border-radius:3px;transition:width .4s cubic-bezier(.2,.7,.2,1)}
.cq2-q{font-family:var(--font-heading--family,inherit);font-size:clamp(1.3rem,2.4vw,1.7rem);font-weight:700;line-height:1.2;margin:0 0 6px}
.cq2-q:focus{outline:none}
.cq2-qs{margin:0 0 8px;font-size:.95rem;line-height:1.45;color:var(--cq-muted)}
.cq2-mode{margin:0 0 18px;font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:var(--cq-muted)}
.cq2-opts{display:grid;grid-template-columns:1fr;gap:var(--cq-gap)}
.cq2-opt{appearance:none;position:relative;display:flex;align-items:center;gap:12px;width:100%;min-height:var(--cq-h);padding:14px 16px;border:1px solid var(--cq-line);border-radius:var(--cq-r);background:transparent;background:linear-gradient(180deg,color-mix(in srgb,var(--cq-bg) 70%,transparent),color-mix(in srgb,var(--cq-bg) 36%,transparent));box-shadow:inset 0 1px 0 var(--cq-hi);color:var(--cq-ink);font:inherit;font-size:.95rem;line-height:1.35;text-align:left;cursor:pointer;-webkit-tap-highlight-color:transparent;transition:border-color .2s,box-shadow .2s,background .2s,transform .15s}
@supports ((-webkit-backdrop-filter:blur(1px)) or (backdrop-filter:blur(1px))){.cq2-opt{-webkit-backdrop-filter:blur(6px) saturate(140%);backdrop-filter:blur(6px) saturate(140%)}}
@media (hover:hover){.cq2-opt:hover{border-color:color-mix(in srgb,var(--cq-ink) 38%,transparent);background:linear-gradient(180deg,color-mix(in srgb,var(--cq-bg) 94%,transparent),color-mix(in srgb,var(--cq-bg) 62%,transparent));box-shadow:inset 0 1px 0 rgba(255,255,255,.8),0 8px 22px -12px rgba(0,0,0,.22)}}
.cq2-opt:active{transform:scale(.985)}
@media (hover:none){.cq2-opt:active{background:var(--cq-soft)}}
.cq2-opt[aria-pressed=true]{border-color:var(--cq-ink);background:linear-gradient(180deg,color-mix(in srgb,var(--cq-acc) 7%,var(--cq-bg)),color-mix(in srgb,var(--cq-acc) 3%,var(--cq-bg)));box-shadow:inset 0 0 0 1px var(--cq-ink),inset 0 2px 0 var(--cq-hi)}
.cq2-dot{flex:none;width:20px;height:20px;border-radius:50%;border:1.5px solid color-mix(in srgb,var(--cq-ink) 30%,transparent);display:grid;place-items:center;transition:background .2s,border-color .2s}
.is-multi .cq2-dot{border-radius:6px}
.cq2-opt[aria-pressed=true] .cq2-dot{background:var(--cq-acc);border-color:var(--cq-acc);animation:cq2Pop .22s cubic-bezier(.2,.7,.2,1)}
.cq2-opt[aria-pressed=true] .cq2-dot:after{content:"";width:7px;height:7px;border-radius:50%;background:#fff}
.is-multi .cq2-opt[aria-pressed=true] .cq2-dot:after{width:10px;height:6px;border-radius:0;background:none;border-left:2px solid #fff;border-bottom:2px solid #fff;transform:translateY(-1px) rotate(-45deg)}
@keyframes cq2Pop{0%{transform:scale(.6)}100%{transform:scale(1)}}
.cq2-lab{flex:1;min-width:0}
.cq2-nav{display:grid;grid-template-columns:1fr auto;align-items:center;gap:var(--cq-gap);margin-top:28px;min-height:52px}
.cq2-navl{display:flex;gap:20px}
.cq2-navl.is-off{visibility:hidden}
.cq2-link{appearance:none;border:0;background:none;padding:8px 0;font:inherit;font-size:.88rem;color:var(--cq-muted);cursor:pointer;text-decoration:underline;text-underline-offset:3px}
@media (hover:hover){.cq2-link:hover{color:var(--cq-ink)}}
.cq2-btn{appearance:none;display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 26px;border:1.5px solid var(--cq-ink);border-radius:999px;background:var(--cq-ink);color:var(--cq-bg);font:inherit;font-weight:600;font-size:.82rem;letter-spacing:.06em;text-transform:uppercase;text-align:center;line-height:1.2;cursor:pointer;-webkit-tap-highlight-color:transparent;box-shadow:inset 0 1px 0 rgba(255,255,255,.18);transition:opacity .2s,filter .2s,box-shadow .2s,background .2s,border-color .2s,transform .15s}
.cq2-btn:active{transform:scale(.985)}
.cq2-btn:disabled{opacity:.3;cursor:not-allowed;transform:none}
.cq2-next{min-width:180px}
.cq2-btn.acc{background:var(--cq-acc);border-color:var(--cq-acc);color:#fff;box-shadow:inset 0 1px 0 rgba(255,255,255,.3),0 10px 24px -14px rgba(179,32,42,.8)}
@media (hover:hover){.cq2-btn:not(:disabled):hover{filter:brightness(1.08)}.cq2-btn.acc:hover{box-shadow:inset 0 1px 0 rgba(255,255,255,.4),0 14px 28px -12px rgba(179,32,42,.85)}}
.cq2-btn.line{background:transparent;color:var(--cq-ink);border-color:color-mix(in srgb,var(--cq-ink) 40%,transparent);box-shadow:inset 0 1px 0 var(--cq-hi)}
@media (hover:hover){.cq2-btn.line:hover{filter:none;border-color:var(--cq-ink);background:var(--cq-soft)}}
.cq2-btn.sm{min-height:40px;padding:0 18px;font-size:.76rem}
.cq2-q+.cq2-chips{margin-top:14px}
.cq2-chips{list-style:none;margin:0 0 18px;padding:0;display:flex;flex-wrap:wrap;gap:8px}
.cq2-chips li{font-size:.82rem;padding:6px 12px;border:1px solid var(--cq-line);border-radius:999px;background:linear-gradient(180deg,color-mix(in srgb,var(--cq-bg) 70%,transparent),color-mix(in srgb,var(--cq-bg) 36%,transparent))}
.cq2-chips li b{font-weight:600}
.cq2-lead{margin:0 0 20px;font-size:.98rem;line-height:1.5}
.cq2-how{margin:0 0 20px;padding:18px 20px;border:1px solid var(--cq-line);border-radius:var(--cq-r);background:linear-gradient(180deg,color-mix(in srgb,var(--cq-bg) 70%,transparent),color-mix(in srgb,var(--cq-bg) 36%,transparent));box-shadow:inset 0 1px 0 var(--cq-hi)}
.cq2-how h4{margin:0 0 12px;font-size:.76rem;letter-spacing:.06em;text-transform:uppercase;color:var(--cq-muted);font-weight:600}
.cq2-how ol{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.cq2-how li{display:grid;grid-template-columns:24px 1fr;gap:12px;align-items:start;font-size:.95rem;line-height:1.45}
.cq2-how li i{width:24px;height:24px;border-radius:50%;background:var(--cq-acc);color:#fff;display:grid;place-items:center;font-style:normal;font-size:.75rem;font-weight:700;margin-top:-1px}
.cq2-how kbd{font:inherit;font-weight:600;padding:1px 7px;border:1px solid var(--cq-line);border-bottom-width:2px;border-radius:6px;white-space:nowrap}
.cq2-acts{display:grid;grid-template-columns:1fr 1fr;gap:var(--cq-gap)}
.cq2-acts .cq2-btn{width:100%}
.cq2-status{margin:14px 0 0;padding:14px 16px;border:1px solid var(--cq-line);border-radius:var(--cq-r);font-size:.93rem;line-height:1.45;display:grid;gap:12px}
.cq2-status[hidden]{display:none}
.cq2-status.is-ok{border-color:color-mix(in srgb,var(--cq-ink) 30%,transparent)}
.cq2-status.is-warn{border-color:var(--cq-acc);background:color-mix(in srgb,var(--cq-acc) 6%,transparent)}
.cq2-status .cq2-btn{justify-self:start}
.cq2-nav .cq2-confirm{grid-column:1/-1}
.cq2-confirm{padding:16px;border:1px solid var(--cq-acc);border-radius:var(--cq-r);display:grid;gap:14px}
.cq2-confirm p{margin:0;font-size:.95rem;line-height:1.45}
.cq2-confirm div{display:grid;grid-template-columns:1fr 1fr;gap:var(--cq-gap)}
.cq2 details{margin-top:22px;font-size:.88rem}
.cq2 summary{display:inline-block;cursor:pointer;color:var(--cq-muted);padding:6px 0;text-decoration:underline;text-underline-offset:3px;list-style:none}
.cq2 summary::-webkit-details-marker{display:none}
.cq2-msg{display:block;width:100%;min-height:220px;margin:10px 0 12px;border:1px solid var(--cq-line);border-radius:var(--cq-r);padding:14px;font:inherit;font-size:.84rem;line-height:1.45;background:transparent;color:var(--cq-ink);resize:vertical}
@media (min-width:640px){.cq2-opts.c2{grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:1fr}.cq2-opts.c3{grid-template-columns:repeat(3,minmax(0,1fr));grid-auto-rows:1fr}}
@media (max-width:639px){.cq2-toggle{gap:12px;padding:16px 0;flex-wrap:wrap}.cq2-tt{flex:1 1 0}.cq2-ico{width:34px;height:34px}.cq2-cta{width:100%;min-height:48px;font-size:.84rem}.cq2.open .cq2-cta{width:36px;min-height:36px;padding:0;gap:0}.cq2.open .cq2-cta span{display:none}.cq2-wrap{padding:24px 0 32px}.cq2-path{gap:8px;margin-bottom:22px}.cq2-path li{flex-direction:column;align-items:flex-start;gap:6px;font-size:.74rem}.cq2-nav{grid-template-columns:1fr;gap:6px}.cq2-next{order:-1;width:100%}.cq2-navl{justify-content:space-between}.cq2-acts,.cq2-confirm div{grid-template-columns:1fr}.cq2-how{padding:16px}}
@media (prefers-reduced-motion:reduce){.cq2 *,.cq2 *:before,.cq2 *:after{animation:none!important;transition:none!important}}
</style>

<div class="cq2" id="cq2-root" data-lang="{{ cq_lang }}">
  <button type="button" class="cq2-toggle" id="cq2-toggle" aria-expanded="false" aria-controls="cq2-body">
    <span class="cq2-ico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M6 20c0-6 2-9 5-11s5-5 3-7M12 20c0-5 1.5-7 4-9s3-4 2-6M8 4c-2 3-3 6-3 9"/></svg></span>
    <span class="cq2-tt"><b data-t="ask"></b><small data-t="ask2"></small></span>
    <span class="cq2-cta"><span data-t="cta"></span><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span>
  </button>
  <div class="cq2-body" id="cq2-body"><div><div class="cq2-wrap"><ol class="cq2-path" id="cq2-path"></ol><div class="cq2-stage" id="cq2-stage"></div></div></div></div>
</div>
