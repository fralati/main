{% comment %}
  cliCHair Hair Quiz - builds the visitor's hair avatar step by step and
  generates a ready-to-paste prompt for clichAIr (Zipchat).
  Languages: EN (default), IT, DE, FR - picked from the storefront locale.
  Usage: paste the whole file into a Custom Liquid block, or save it as
  snippets/clichair-hair-quiz.liquid and render the snippet from the Custom Liquid block.
{% endcomment %}
{%- assign cq_lang = request.locale.iso_code | slice: 0, 2 | downcase -%}
<style>
.cq{--cq-ink:var(--color-foreground,#111);--cq-bg:var(--color-background,#fff);--cq-acc:#b3202a;--cq-line:#e6e6e6;--cq-soft:#f5f5f5;--cq-r:14px;font-family:var(--font-body--family,Inter,system-ui,sans-serif);color:var(--cq-ink);background:var(--cq-bg);width:100%;box-sizing:border-box;padding:8px 0 24px}
.cq *{box-sizing:border-box}
.cq-head{margin:0 0 18px}
.cq-kicker{font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:var(--cq-acc);font-weight:700;margin:0 0 6px}
.cq-title{font-family:var(--font-heading--family,inherit);font-size:clamp(1.5rem,3vw,2.2rem);font-weight:700;line-height:1.1;margin:0 0 8px;text-transform:uppercase}
.cq-sub{margin:0;opacity:.8;max-width:60ch}
.cq-grid{display:grid;grid-template-columns:minmax(260px,340px) 1fr;gap:28px;align-items:start}
.cq-visual{position:sticky;top:90px;border:1px solid var(--cq-line);border-radius:var(--cq-r);padding:16px;background:var(--cq-bg)}
.cq-svgs{display:grid;grid-template-columns:1fr 84px;gap:8px;align-items:end}
.cq-svgs svg{width:100%;height:auto;display:block}
.cq-strand-label{font-size:.7rem;text-align:center;opacity:.75;margin-top:4px;line-height:1.2}
.cq-pass{margin:12px 0 0;padding:0;list-style:none;display:flex;flex-wrap:wrap;gap:6px}
.cq-pass li{font-size:.72rem;border:1px solid var(--cq-line);border-radius:999px;padding:4px 10px;background:var(--cq-soft)}
.cq-pass li b{font-weight:600}
.cq-panel{border:1px solid var(--cq-line);border-radius:var(--cq-r);padding:22px;min-height:360px}
.cq-prog{display:flex;align-items:center;gap:12px;font-size:.78rem;opacity:.8;margin-bottom:14px}
.cq-bar{flex:1;height:4px;background:var(--cq-line);border-radius:4px;overflow:hidden}
.cq-bar i{display:block;height:100%;background:var(--cq-acc);width:0;transition:width .35s ease}
.cq-q{font-size:1.25rem;font-weight:700;margin:0 0 4px;line-height:1.2}
.cq-qs{margin:0 0 16px;font-size:.9rem;opacity:.75}
.cq-opts{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.cq-opt{appearance:none;border:1.5px solid var(--cq-line);background:var(--cq-bg);color:var(--cq-ink);border-radius:12px;padding:14px 12px;text-align:left;cursor:pointer;font:inherit;font-size:.92rem;line-height:1.25;transition:border-color .15s,background .15s,transform .15s;display:flex;align-items:center;gap:10px}
.cq-opt:hover{border-color:var(--cq-ink);transform:translateY(-1px)}
.cq-opt[aria-pressed=true]{border-color:var(--cq-acc);background:#fff4f4;box-shadow:inset 0 0 0 1px var(--cq-acc)}
.cq-sw{width:22px;height:22px;border-radius:50%;flex:none;border:1px solid rgba(0,0,0,.15)}
.cq-nav{display:flex;justify-content:space-between;gap:10px;margin-top:22px}
.cq-btn{appearance:none;border:1.5px solid var(--cq-ink);background:var(--cq-ink);color:#fff;border-radius:999px;padding:12px 22px;font:inherit;font-weight:600;font-size:.88rem;letter-spacing:.04em;text-transform:uppercase;cursor:pointer;transition:opacity .15s}
.cq-btn:disabled{opacity:.35;cursor:not-allowed}
.cq-btn.ghost{background:transparent;color:var(--cq-ink)}
.cq-btn.acc{background:var(--cq-acc);border-color:var(--cq-acc)}
.cq-start{text-align:center;padding:30px 10px}
.cq-start p{max-width:52ch;margin:0 auto 18px;opacity:.85}
.cq-sum h3{margin:18px 0 8px;font-size:1rem}
.cq-prompt{width:100%;min-height:260px;border:1px solid var(--cq-line);border-radius:12px;padding:14px;font:inherit;font-size:.85rem;line-height:1.45;background:var(--cq-soft);color:var(--cq-ink);resize:vertical}
.cq-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px}
.cq-hint{font-size:.82rem;opacity:.8;margin:10px 0 0}
.cq-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:8px 0 0}
.cq-steps div{border:1px solid var(--cq-line);border-radius:12px;padding:12px;font-size:.82rem}
.cq-steps b{display:block;font-size:1.3rem;color:var(--cq-acc);margin-bottom:4px}
@media (max-width:820px){.cq-grid{grid-template-columns:1fr}.cq-visual{position:static;display:grid;grid-template-columns:150px 1fr;gap:12px;align-items:center}.cq-svgs{grid-template-columns:1fr 46px}.cq-panel{padding:16px;min-height:0}.cq-steps{grid-template-columns:1fr}}
</style>

<div class="cq" id="cq-root" data-lang="{{ cq_lang }}">
  <div class="cq-head">
    <p class="cq-kicker" data-t="kick"></p>
    <h2 class="cq-title" data-t="title"></h2>
    <p class="cq-sub" data-t="sub"></p>
  </div>
  <div class="cq-grid">
    <aside class="cq-visual">
      <div class="cq-svgs">
        <div id="cq-avatar"></div>
        <div><div id="cq-strand"></div><div class="cq-strand-label" id="cq-strand-label"></div></div>
      </div>
      <ul class="cq-pass" id="cq-pass"></ul>
    </aside>
    <div class="cq-panel" id="cq-panel"></div>
  </div>
</div>

