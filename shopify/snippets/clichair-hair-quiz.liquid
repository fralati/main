{% comment %} cliCHair Hair Quiz v3 (7 domande, colonna unica, pulsante di avvio) {% endcomment %}
{%- assign cq_lang = request.locale.iso_code | slice: 0, 2 | downcase -%}
<style>
.cq2{--cq-ink:var(--color-foreground,#1a1a1a);--cq-acc:#b3202a;--cq-line:color-mix(in srgb,var(--cq-ink) 14%,transparent);--cq-soft:color-mix(in srgb,var(--cq-ink) 4%,transparent);--cq-muted:color-mix(in srgb,var(--cq-ink) 62%,transparent);font-family:var(--font-body--family,system-ui,sans-serif);color:var(--cq-ink);width:100%;box-sizing:border-box}
.cq2 *{box-sizing:border-box}
div:has(>.cq2){width:100%!important;max-width:100%!important;flex:1 1 100%;align-self:stretch}
.cq2-toggle{appearance:none;width:100%;display:flex;align-items:center;gap:16px;padding:20px 2px;border:0;border-top:1px solid var(--cq-line);border-bottom:1px solid var(--cq-line);background:transparent;color:var(--cq-ink);font:inherit;text-align:left;cursor:pointer}
.cq2-toggle:focus{outline:none}
.cq2-toggle:focus-visible{outline:2px solid var(--cq-acc);outline-offset:3px}
.cq2-ico{width:40px;height:40px;flex:none;border-radius:50%;background:var(--cq-acc);display:grid;place-items:center}
.cq2-tt{flex:1;min-width:0}
.cq2-tt b{display:block;font-family:var(--font-heading--family,inherit);font-weight:700;font-size:clamp(1.05rem,2vw,1.4rem);text-transform:uppercase;letter-spacing:.02em;line-height:1.15}
.cq2-tt small{display:block;font-size:.84rem;color:var(--cq-muted);margin-top:4px;line-height:1.35}
.cq2-cta{flex:none;display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;padding:0 20px 0 22px;border:1.5px solid var(--cq-acc);border-radius:999px;background:var(--cq-acc);color:#fff;font-weight:600;font-size:.82rem;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;transition:background .2s,color .2s,border-color .2s,filter .2s;animation:cq2Pulse 2.6s ease-out 1s infinite}
.cq2-cta svg{transform:rotate(-90deg);transition:transform .45s cubic-bezier(.2,.7,.2,1)}
.cq2-toggle:hover .cq2-cta{filter:brightness(.9)}
.cq2-toggle:hover .cq2-cta svg{transform:rotate(-90deg) translateY(3px)}
.cq2.open .cq2-cta{background:transparent;color:var(--cq-ink);border-color:var(--cq-ink);animation:none}
.cq2.open .cq2-cta svg,.cq2.open .cq2-toggle:hover .cq2-cta svg{transform:rotate(180deg)}
.cq2.open .cq2-toggle:hover .cq2-cta{filter:none;background:var(--cq-soft)}
@keyframes cq2Pulse{0%{box-shadow:0 0 0 0 rgba(179,32,42,.45)}70%{box-shadow:0 0 0 12px rgba(179,32,42,0)}100%{box-shadow:0 0 0 0 rgba(179,32,42,0)}}
.cq2-body{display:grid;grid-template-rows:0fr;transition:grid-template-rows .5s cubic-bezier(.2,.7,.2,1)}
.cq2-body>div{overflow:hidden;min-height:0}
.cq2.open .cq2-body{grid-template-rows:1fr}
.cq2-wrap{max-width:680px;margin:0 auto;padding:36px 0 44px}
.cq2-in{animation:cq2In .35s cubic-bezier(.2,.7,.2,1) both}
@keyframes cq2In{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.cq2 *{animation:none!important;transition:none!important}}
.cq2-prog{display:flex;align-items:center;gap:14px;font-size:.76rem;letter-spacing:.06em;text-transform:uppercase;color:var(--cq-muted);margin-bottom:22px}
.cq2-bar{flex:1;height:2px;background:var(--cq-line);border-radius:2px;overflow:hidden}
.cq2-bar i{display:block;height:100%;background:var(--cq-acc);transition:width .35s ease}
.cq2-q{font-family:var(--font-heading--family,inherit);font-size:clamp(1.3rem,2.4vw,1.7rem);font-weight:700;line-height:1.15;margin:0 0 6px}
.cq2-qs{margin:0 0 10px;font-size:.92rem;color:var(--cq-muted)}
.cq2-mode{margin:0 0 18px;font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:var(--cq-muted)}
.cq2-mode:before{content:"";display:inline-block;width:9px;height:9px;border:1.5px solid currentColor;border-radius:50%;margin-right:7px;vertical-align:1px}
.cq2-mode.is-multi:before{border-radius:2px}
.cq2-opts{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,220px),1fr));gap:10px}
.cq2-opt{appearance:none;display:flex;align-items:center;gap:12px;min-height:52px;padding:12px 16px;border:1px solid var(--cq-line);border-radius:12px;background:transparent;color:var(--cq-ink);font:inherit;font-size:.93rem;line-height:1.3;text-align:left;cursor:pointer;transition:border-color .15s,background .15s}
.cq2-opt:hover{border-color:var(--cq-ink)}
.cq2-opt:focus{outline:none}
.cq2-opt:focus-visible{outline:2px solid var(--cq-acc);outline-offset:2px}
.cq2-opt[aria-pressed=true]{border-color:var(--cq-ink);background:var(--cq-soft);box-shadow:inset 0 0 0 1px var(--cq-ink)}
.cq2-opt .cq2-dot{width:18px;height:18px;flex:none;border-radius:50%;border:1.5px solid var(--cq-line);display:grid;place-items:center}
.cq2-opt[aria-pressed=true] .cq2-dot{border-color:var(--cq-acc);background:var(--cq-acc)}
.cq2-opt[aria-pressed=true] .cq2-dot:after{content:"";width:6px;height:6px;border-radius:50%;background:#fff}
.is-multi .cq2-dot{border-radius:4px}
.is-multi .cq2-opt[aria-pressed=true] .cq2-dot:after{width:10px;height:6px;border-radius:0;background:none;border-left:2px solid #fff;border-bottom:2px solid #fff;transform:translateY(-1px) rotate(-45deg)}
.cq2-nav{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:28px}
.cq2-btn{appearance:none;border:1.5px solid var(--cq-ink);background:var(--cq-ink);color:var(--color-background,#fff);border-radius:999px;padding:13px 26px;font:inherit;font-weight:600;font-size:.82rem;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;transition:opacity .15s}
.cq2-btn:disabled{opacity:.3;cursor:not-allowed}
.cq2-btn.acc{background:var(--cq-acc);border-color:var(--cq-acc);color:#fff}
.cq2-btn.line{background:transparent;color:var(--cq-ink)}
.cq2-link{appearance:none;border:0;background:none;padding:6px 0;font:inherit;font-size:.85rem;color:var(--cq-muted);cursor:pointer;text-decoration:underline;text-underline-offset:3px}
.cq2-link:hover{color:var(--cq-ink)}
.cq2-navl{display:flex;gap:18px}
.cq2-navl[hidden]{visibility:hidden;display:flex}
.cq2-chips{list-style:none;margin:0 0 24px;padding:0;display:flex;flex-wrap:wrap;gap:8px}
.cq2-chips li{font-size:.8rem;padding:6px 12px;border:1px solid var(--cq-line);border-radius:999px}
.cq2-chips li b{font-weight:600}
.cq2-lead{margin:0 0 22px;font-size:.95rem;line-height:1.5;max-width:58ch}
.cq2-acts{display:flex;flex-wrap:wrap;align-items:center;gap:12px}
.cq2-hint{font-size:.84rem;color:var(--cq-muted);margin:14px 0 0}
.cq2-hint:empty{display:none}
.cq2 details{margin-top:22px;font-size:.85rem}
.cq2 summary{cursor:pointer;color:var(--cq-muted);padding:0;list-style:none}
.cq2 summary::-webkit-details-marker{display:none}
.cq2-msg{width:100%;min-height:220px;margin-top:10px;border:1px solid var(--cq-line);border-radius:12px;padding:14px;font:inherit;font-size:.82rem;line-height:1.45;background:transparent;color:var(--cq-ink);resize:vertical}
@media (max-width:600px){.cq2-toggle{gap:12px;padding:16px 0;flex-wrap:wrap}.cq2-tt{flex:1 1 0}.cq2-ico{width:34px;height:34px}.cq2-cta{width:100%;min-height:48px;font-size:.84rem}.cq2.open .cq2-cta{width:36px;min-height:36px;padding:0;gap:0}.cq2.open .cq2-cta span{display:none}.cq2-wrap{padding:26px 0 32px}.cq2-opts{grid-template-columns:1fr 1fr}.cq2-opt{padding:12px;font-size:.88rem}.cq2-acts .cq2-btn{width:100%}}
</style>

<div class="cq2" id="cq2-root" data-lang="{{ cq_lang }}">
  <button type="button" class="cq2-toggle" id="cq2-toggle" aria-expanded="false" aria-controls="cq2-body">
    <span class="cq2-ico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M6 20c0-6 2-9 5-11s5-5 3-7M12 20c0-5 1.5-7 4-9s3-4 2-6M8 4c-2 3-3 6-3 9"/></svg></span>
