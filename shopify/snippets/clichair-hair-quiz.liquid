var L=T[LANG]||T.en;
var KEY='cq_state_v1';
var S={};try{S=JSON.parse(localStorage.getItem(KEY)||'{}')||{};}catch(e){S={};}
var step=(typeof S._step==='number')?S._step:-1;
function save(){try{S._step=step;localStorage.setItem(KEY,JSON.stringify(S));}catch(e){}}
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
function lab(k){return L.o[k]||k;}
function has(k,v){return Array.isArray(S[k])&&S[k].indexOf(v)>-1;}
function rnd(seed){var x=Math.sin(seed*9301+49297)*233280;return x-Math.floor(x);}
function mix(a,b,t){function h(c){return [parseInt(c.slice(1,3),16),parseInt(c.slice(3,5),16),parseInt(c.slice(5,7),16)];}var A=h(a),B=h(b),o='#';for(var i=0;i<3;i++){o+=('0'+Math.round(A[i]+(B[i]-A[i])*t).toString(16)).slice(-2);}return o;}
function dark(c){var r=parseInt(c.slice(1,3),16),g=parseInt(c.slice(3,5),16),b=parseInt(c.slice(5,7),16);return (r*.3+g*.59+b*.11)<120;}
function damageLevel(){var s=0;if(has('hist','bleach'))s+=2;if(has('hist','perm'))s++;if(has('hist','keratin'))s++;if(has('hist','heat'))s++;if(has('cond','damaged'))s+=2;if(has('cond','split'))s++;if(has('cond','dry'))s++;if(has('cond','frizz'))s++;if(has('cond','dull'))s++;if(S.col==='bleached')s+=2;if(S.col==='lightened')s++;return s===0?0:s<3?1:s<5?2:3;}
function colors(){var root=HAIR[S.base||'brown'],ends=root,band=false;
 if(S.col==='lightened'){ends=dark(root)?'#b98a4e':'#dcc07f';band=true;}
 else if(S.col==='bleached'){ends='#efe3c2';band=true;}
 else if(S.col==='colored'){ends=dark(root)?'#6e2b2b':mix(root,'#3a2418',.5);band=true;}
 else if(S.col==='natural'){ends=mix(root,'#ffffff',.08);}
 return {root:root,ends:ends,band:band};}
function edge(x,y0,y1,amp,per,seed){var d='',y=y0,i=0,dir=y1>y0?1:-1;if(amp===0)return 'L'+x+' '+y1+' ';while(dir>0?y<y1:y>y1){var ny=dir>0?Math.min(y+per,y1):Math.max(y-per,y1),s=(i%2?1:-1)*amp*(0.7+0.6*rnd(seed+i));d+='Q'+(x+s)+' '+((y+ny)/2)+' '+x+' '+ny+' ';y=ny;i++;}return d;}
function avatar(){var c=colors(),tex=S.tex||'straight',len=S.len||'medium',dens=S.dens||'medium',lvl=damageLevel();
 var bottom={buzz:0,short:138,medium:178,long:222,xlong:254}[len];
 var w={low:44,medium:52,high:60}[dens];
 var amp={straight:0,wavy:5,curly:8,coily:3}[tex],per={straight:0,wavy:34,curly:18,coily:9}[tex];
 if(tex==='wavy')w+=4;if(tex==='curly')w+=10;if(tex==='coily')w+=18;
 if(bottom){if(tex==='curly')bottom=88+(bottom-88)*.85;if(tex==='coily')bottom=88+(bottom-88)*.62;}
 var loss=has('scalp','loss');if(loss)w-=6;
 var bandStop=c.band?'<stop offset="0.12" stop-color="'+c.root+'"/><stop offset="0.18" stop-color="'+c.ends+'"/>':'<stop offset="0.35" stop-color="'+c.root+'"/>';
 var g='<defs><linearGradient id="cqg" gradientUnits="userSpaceOnUse" x1="0" y1="40" x2="0" y2="'+(bottom||150)+'"><stop offset="0" stop-color="'+c.root+'"/>'+bandStop+'<stop offset="1" stop-color="'+c.ends+'"/></linearGradient><radialGradient id="cqs" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#fff" stop-opacity=".55"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></radialGradient></defs>';
 var s='<svg viewBox="0 0 200 270" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">'+g;
 s+='<rect width="200" height="270" rx="16" fill="#f4f1ee"/>';
 s+='<path d="M60 270 V232 Q100 214 140 232 V270Z" fill="#e9e4de"/>';
 var back='';
 if(bottom){var xl=100-w,xr=100+w,seed=len.length+tex.length;
  var d='M'+xl+' 88 '+edge(xl,88,bottom,amp,per,seed);
  if(tex==='coily'){d+='Q'+xl+' '+(bottom+18)+' 100 '+(bottom+16)+' Q'+xr+' '+(bottom+18)+' '+xr+' '+bottom+' ';}
  else if(has('cond','damaged')||lvl>=3){for(var x=xl;x<xr;x+=10){d+='L'+(x+5)+' '+(bottom-6-8*rnd(x))+' L'+(x+10)+' '+bottom+' ';}}
  else if(tex==='straight'){d+='Q100 '+(bottom+10)+' '+xr+' '+bottom+' ';}
  else{for(var x2=xl;x2<xr;x2+=14){d+='Q'+(x2+7)+' '+(bottom+12)+' '+(x2+14)+' '+bottom+' ';}}
  d+=edge(xr,bottom,88,amp,per,seed+7);
  d+='L'+xr+' 88 Q100 14 '+xl+' 88 Z';
  back='<path d="'+d+'" fill="url(#cqg)"/>';
  if(has('cond','frizz')||tex==='coily'&&has('cond','dry')){var f='';for(var i=0;i<26;i++){var side=i%2?xr:xl,yy=95+rnd(i*3)*(bottom-100),dx=(i%2?1:-1)*(6+rnd(i*5)*10);f+='M'+side+' '+yy+' q'+(dx*.5)+' '+(-4-rnd(i)*6)+' '+dx+' '+(-2+rnd(i*7)*8)+' ';}back+='<path d="'+f+'" stroke="'+c.ends+'" stroke-width="1.2" fill="none" opacity=".8"/>';}
  if(has('cond','split')){var sp='';for(var j=0;j<9;j++){var sx=xl+8+j*((xr-xl-16)/8);sp+='M'+sx+' '+(bottom-2)+' l-3 9 M'+sx+' '+(bottom-2)+' l3 9 ';}back+='<path d="'+sp+'" stroke="'+c.ends+'" stroke-width="1.4" fill="none"/>';}
 }
 s+=back;
 s+='<path d="M60 250 Q70 205 88 196 L88 178 H112 L112 196 Q130 205 140 250Z" fill="#e8c4a8"/>';
 s+='<ellipse cx="100" cy="112" rx="42" ry="52" fill="#f1cfb4"/>';
 s+='<path d="M84 104 q5 -4 10 0 M106 104 q5 -4 10 0" stroke="#3a2418" stroke-width="2" fill="none" stroke-linecap="round"/><path d="M92 128 q8 6 16 0" stroke="#b97a60" stroke-width="2" fill="none" stroke-linecap="round"/>';
 var hl=loss?'C82 82 118 82 132 100':'C88 76 112 76 132 100';
 var capTop=tex==='coily'?'C44 18 156 18 148 112':(len==='buzz'?'C58 46 142 46 144 110':'C52 40 148 40 146 110');
 var cap='M54 110 '+capTop+' L146 112 C140 96 125 90 100 92 C75 90 60 96 54 112 Z';
 if(loss)cap='M54 112 C52 40 148 40 146 112 L146 114 C140 100 130 96 118 96 C112 96 106 94 100 94 C94 94 88 96 82 96 C70 96 60 100 54 114 Z';
 var capFill=S.col==='greycover'?'url(#cqcap)':(bottom?'url(#cqg)':c.root);
 if(S.col==='greycover'){s+='<defs><linearGradient id="cqcap" gradientUnits="userSpaceOnUse" x1="0" y1="40" x2="0" y2="110"><stop offset="0" stop-color="#cfcfcf"/><stop offset=".55" stop-color="'+c.root+'"/></linearGradient></defs>';}
 s+='<path d="'+cap+'" fill="'+capFill+'" opacity="'+(len==='buzz'?.9:1)+'"/>';
 if(S.base==='grey'||S.col==='greycover'){s+='<path d="M70 70 q10 -20 22 -24 M96 60 q6 -12 12 -14 M126 68 q-4 -16 -12 -22" stroke="#fff" stroke-opacity=".6" stroke-width="2" fill="none"/>';}
 if(!has('cond','dull')&&!has('cond','dry')&&lvl<3)s+='<ellipse cx="82" cy="62" rx="20" ry="9" fill="url(#cqs)" transform="rotate(-25 82 62)"/>';
 if(has('scalp','oily'))s+='<ellipse cx="100" cy="52" rx="26" ry="7" fill="#fff" opacity=".35"/>';
 if(has('scalp','dandruff')){var dd='';for(var k=0;k<14;k++){dd+='<circle cx="'+(66+rnd(k*2)*68)+'" cy="'+(60+rnd(k*4)*40)+'" r="1.6" fill="#fff" opacity=".9"/>';}s+=dd;}
 if(has('scalp','dryscalp')){var dr='';for(var q=0;q<10;q++){dr+='<rect x="'+(68+rnd(q*3)*64)+'" y="'+(62+rnd(q*5)*38)+'" width="3" height="2" fill="#f3e4c9"/>';}s+=dr;}
 if(has('scalp','sensitive'))s+='<path d="M60 100 C70 88 130 88 140 100" stroke="#e57a7a" stroke-width="5" fill="none" opacity=".5" stroke-linecap="round"/>';
 s+='</svg>';
 document.getElementById('cq-avatar').innerHTML=s;
 strand(c,lvl);
}
function strand(c,lvl){var tw={fine:8,medium:12,thick:17}[S.thick||'medium'],fr=has('cond','frizz'),col=c.ends;
 var s='<svg viewBox="0 0 80 240" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs><linearGradient id="cqst" x1="0" x2="1"><stop offset="0" stop-color="'+mix(col,'#000000',.25)+'"/><stop offset=".45" stop-color="'+col+'"/><stop offset="1" stop-color="'+mix(col,'#000000',.35)+'"/></linearGradient></defs>';
 s+='<rect width="80" height="240" rx="12" fill="#f4f1ee"/>';
 var x0=40-tw/2,x1=40+tw/2,path;
 if(fr){path='M'+x0+' 14 '+edge(x0,14,210,3,22,3)+'L'+x1+' 210 '+edge(x1,210,14,3,22,3)+'Z';}
 else path='M'+x0+' 14 L'+x0+' 210 L'+x1+' 210 L'+x1+' 14 Z';
 if(has('cond','split')||lvl===3){path=path.replace('L'+x1+' 210','L'+(x0-6)+' 232 L'+x0+' 210 L40 206 L'+x1+' 210 L'+(x1+6)+' 232');}
 s+='<path d="'+path+'" fill="url(#cqst)"/>';
 var sc='';for(var y=22;y<206;y+=11){var lift=lvl===0?0:(rnd(y)*4<lvl?lvl*1.6:0);sc+='M'+(x0-lift)+' '+(y-lift)+' L40 '+(y+5)+' L'+(x1+lift)+' '+(y-lift)+' ';}
 s+='<path d="'+sc+'" stroke="#fff" stroke-opacity="'+(lvl>=2?.55:.35)+'" stroke-width="1" fill="none"/>';
 if(lvl>=3){for(var g=0;g<4;g++){s+='<rect x="'+(x0-1)+'" y="'+(60+g*38)+'" width="'+(tw*.4)+'" height="4" fill="#f4f1ee"/>';}}
 if(lvl===0&&!has('cond','dull'))s+='<rect x="'+(x0+2)+'" y="20" width="2" height="180" fill="#fff" opacity=".5" rx="1"/>';
 s+='</svg>';
 document.getElementById('cq-strand').innerHTML=s;
 document.getElementById('cq-strand-label').textContent=(S.thick||S.cond)?L.cut[lvl]:'';
