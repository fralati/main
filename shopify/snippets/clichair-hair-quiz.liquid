};
var L=T[LANG]||T.en;
var KEY='cq_state_v3';
var S={};try{S=JSON.parse(localStorage.getItem(KEY)||'{}')||{};}catch(e){S={};}
var step=(typeof S._step==='number')?S._step:-1;
function save(){try{S._step=step;localStorage.setItem(KEY,JSON.stringify(S));}catch(e){}}
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
function lab(k){return L.o[k]||k;}
function has(k,v){return Array.isArray(S[k])&&S[k].indexOf(v)>-1;}
function valid(q){var v=S[q.k];return q.m?Array.isArray(v)&&v.length>0:!!v;}
function short(v){return lab(v).replace(/\s*\([^)]*\)/g,'');}
function pick(q,v){
 if(q.m){var a=Array.isArray(S[q.k])?S[q.k].slice():[];var i=a.indexOf(v);
  if(i>-1)a.splice(i,1);else{if(q.x&&v===q.x)a=[];else if(q.x)a=a.filter(function(z){return z!==q.x;});if(q.ex&&q.ex[v])a=a.filter(function(z){return z!==q.ex[v];});if(q.max&&a.length>=q.max)a.shift();a.push(v);}
  S[q.k]=a;}
 else{S[q.k]=(S[q.k]===v)?null:v;}
 save();render(false);
}
var P=document.getElementById('cq2-panel');
function head(){var a=ROOT.querySelector('[data-t="ask"]'),b=ROOT.querySelector('[data-t="ask2"]'),c=ROOT.querySelector('[data-t="cta"]');
 c.textContent=ROOT.classList.contains('open')?L.close:(step>=QS.length?L.finish:(step>0?L.resume:L.cta));
 if(step>0&&step<QS.length){a.textContent=L.cont;b.textContent=L.step+' '+(step+1)+' '+L.of+' '+QS.length;}else{a.textContent=L.ask;b.textContent=L.ask2;}}
var LASTSTEP=-1;
function render(scroll){
 if(step<0)step=0;
 if(step>=QS.length){summary();head();return;}
 var q=QS[step],pct=Math.round(step/QS.length*100),h=(LASTSTEP===step)?'<div>':'<div class="cq2-in">';LASTSTEP=step;
 h+='<div class="cq2-prog"><span>'+esc(L.step)+' '+(step+1)+' '+esc(L.of)+' '+QS.length+'</span><div class="cq2-bar"><i style="width:'+pct+'%"></i></div></div>';
 h+='<h3 class="cq2-q">'+esc(L.q[q.k][0])+'</h3><p class="cq2-qs">'+esc(L.q[q.k][1])+'</p><p class="cq2-mode'+(q.m?' is-multi':'')+'">'+esc(q.m?(q.max?L.max2:L.multi):L.single)+'</p><div class="cq2-opts'+(q.m?' is-multi':'')+'">';
 q.o.forEach(function(o){var on=q.m?has(q.k,o):S[q.k]===o;
  h+='<button type="button" class="cq2-opt" data-v="'+o+'" aria-pressed="'+on+'">'+'<span class="cq2-dot"></span>'+'<span>'+esc(lab(o))+'</span></button>';});
 h+='</div><div class="cq2-nav"><span class="cq2-navl"'+(step===0?' hidden':'')+'><button type="button" class="cq2-link" id="cq2-back">'+esc(L.back)+'</button><button type="button" class="cq2-link" id="cq2-reset">'+esc(L.restart)+'</button></span><button type="button" class="cq2-btn" id="cq2-next"'+(valid(q)?'':' disabled')+'>'+esc(step===QS.length-1?L.finish:L.next)+'</button></div></div>';
 P.innerHTML=h;head();
 P.querySelectorAll('.cq2-opt').forEach(function(b){b.onclick=function(){pick(q,b.getAttribute('data-v'));};});
 document.getElementById('cq2-back').onclick=function(){if(step>0){step--;save();render(true);}};
 document.getElementById('cq2-next').onclick=function(){if(valid(q)){step++;save();render(true);}};
 document.getElementById('cq2-reset').onclick=function(){S={};step=0;save();render(true);};
 if(scroll){var r=ROOT.getBoundingClientRect();if(r.top<0||r.top>window.innerHeight*.5)ROOT.scrollIntoView({behavior:'smooth',block:'start'});}
}
function prompt(){var p=L.p,o=[p.hi,'',p.prof];
 ['tex','hair','colhist','cond','scalp'].forEach(function(k){var v=S[k];if(!v||(Array.isArray(v)&&!v.length))return;o.push('- '+p.L[k]+': '+(Array.isArray(v)?v.map(lab).join(', '):lab(v)));});
 o.push('');o.push(p.L.goal+': '+(S.goal||[]).map(lab).join(', '));
 o.push(p.L.budget+': '+lab(S.budget||'complete'));
 o.push('');o.push(p.ask);p.steps.forEach(function(s,i){o.push((i+1)+'. '+s);});
 return o.join('\n');}
function deepFind(sel,root){var el=null;try{el=root.querySelector(sel);}catch(e){}if(el)return el;
 var all=root.querySelectorAll('*');for(var i=0;i<all.length&&!el;i++){if(all[i].shadowRoot)el=deepFind(sel,all[i].shadowRoot);}
 if(!el&&root===document){var fr=document.querySelectorAll('iframe');for(var j=0;j<fr.length&&!el;j++){try{var d=fr[j].contentDocument;if(d)el=deepFind(sel,d);}catch(e){}}}
 return el;}
function fillChat(txt){var n=0,t=setInterval(function(){n++;var el=deepFind('[data-zipchat] textarea,[id*="zipchat"] textarea,[class*="zipchat"] textarea',document);
 if(el){try{el.focus();el.value=txt;el.dispatchEvent(new Event('input',{bubbles:true}));}catch(e){}clearInterval(t);}else if(n>20)clearInterval(t);},250);}
function openChat(){var el=deepFind(ZIPCHAT_SELECTOR+',#zipchat-launcher,[id*="zipchat"] button',document);if(el){try{el.click();return true;}catch(e){}}
 var z=window.Zipchat||window.zipchat;if(z){['open','show','toggle'].forEach(function(m){if(typeof z[m]==='function'){try{z[m]();}catch(e){}}});}return false;}
function summary(){var txt=prompt(),h='<div class="cq2-in">';
 h+='<div class="cq2-prog"><span>'+esc(L.sumT)+'</span><div class="cq2-bar"><i style="width:100%"></i></div></div>';
 h+='<h3 class="cq2-q">'+esc(L.sumT)+'</h3><ul class="cq2-chips">';
 ['tex','hair','colhist','cond','scalp','goal'].forEach(function(k){var v=S[k];if(!v||(Array.isArray(v)&&!v.length))return;
  var vals=(Array.isArray(v)?v:[v]).filter(function(x){return x!=='healthy'&&x!=='normal';});if(!vals.length)return;
  h+='<li><b>'+esc(L.q[k][0])+':</b> '+esc(vals.map(short).join(', '))+'</li>';});
 h+='</ul><p class="cq2-lead">'+esc(L.nextT)+'</p>';
 h+='<div class="cq2-acts"><button type="button" class="cq2-btn acc" id="cq2-open">'+esc(L.open)+'</button><button type="button" class="cq2-btn line" id="cq2-copy">'+esc(L.copy)+'</button><button type="button" class="cq2-link" id="cq2-restart">'+esc(L.restart)+'</button></div><p class="cq2-hint" id="cq2-hint"></p>';
 h+='<details><summary>'+esc(L.showMsg)+'</summary><textarea class="cq2-msg" id="cq2-txt" readonly>'+esc(txt)+'</textarea></details></div>';
 P.innerHTML=h;
 var cp=document.getElementById('cq2-copy'),hn=document.getElementById('cq2-hint');
 function copy(){var ta=document.getElementById('cq2-txt');var done=function(){cp.textContent=L.copied;hn.textContent=L.hint;setTimeout(function(){cp.textContent=L.copy;},1800);};
  var fb=function(){try{ta.parentNode.open=true;ta.select();document.execCommand('copy');}catch(e){}done();};
  if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(ta.value).then(done,fb);}else{fb();}}
 cp.onclick=copy;
 document.getElementById('cq2-open').onclick=function(){copy();openChat();fillChat(txt);};
 document.getElementById('cq2-restart').onclick=function(){S={};step=0;save();render(true);};
}
var TG=document.getElementById('cq2-toggle');
TG.onclick=function(){var open=!ROOT.classList.contains('open');ROOT.classList.toggle('open',open);TG.setAttribute('aria-expanded',open);if(open&&step<0){step=0;save();render(false);}head();};
head();if(step>=0)render(false);
})();
</script>
