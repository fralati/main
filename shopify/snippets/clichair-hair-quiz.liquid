 var amp2=V.amp*.6+V.frizz*1.5,per2=Math.max(8,V.per*.7),pts=[];
 for(var y=30;y<=225;y+=3){pts.push([250+amp2*Math.sin((y-30)/per2*Math.PI)+(rnd(y)-.5)*V.frizz*2,y]);}
 var line='M'+pts.map(function(p){return p[0].toFixed(1)+' '+p[1];}).join('L'),hw=V.tw/2;
 s+='<path d="'+line+'" stroke="url(#cqst)" stroke-width="'+V.tw.toFixed(1)+'" fill="none" stroke-linecap="round"/><path d="'+line+'" stroke="url(#cqsr)" stroke-width="'+V.tw.toFixed(1)+'" fill="none" stroke-linecap="round"/>';
 var sc='';for(var i2=3;i2<pts.length-3;i2+=3){var p=pts[i2],lift=Math.max(0,V.lvl-rnd(i2)*3)*1.3;sc+='M'+(p[0]-hw-lift).toFixed(1)+' '+(p[1]-lift).toFixed(1)+' L'+p[0].toFixed(1)+' '+(p[1]+4)+' L'+(p[0]+hw+lift).toFixed(1)+' '+(p[1]-lift).toFixed(1)+' ';}
 s+='<path d="'+sc+'" stroke="#fff" stroke-opacity="'+(.3+.1*V.lvl).toFixed(2)+'" stroke-width="1" fill="none"/>';
 var ga=cl(V.lvl-2,0,1);if(ga>.02){for(var g=0;g<4;g++){var pg=pts[8+g*14];s+='<rect x="'+(pg[0]-hw-1).toFixed(1)+'" y="'+pg[1]+'" width="'+(V.tw*.45).toFixed(1)+'" height="4" fill="'+BG+'" opacity="'+ga.toFixed(2)+'"/>';}}
 s+='<path d="'+line+'" stroke="#fff" stroke-width="1.6" fill="none" stroke-linecap="round" transform="translate('+(-hw+2.2).toFixed(1)+' 0)" opacity="'+(V.shine*.45).toFixed(2)+'"/>';
 if(V.frizz>.02){var fb='';for(var i3=0;i3<8;i3++){var pf=pts[4+i3*7],dr2=i3%2?1:-1;fb+='M'+(pf[0]+dr2*hw).toFixed(1)+' '+pf[1]+' q'+(dr2*5)+' -3 '+(dr2*9)+' -9 ';}s+='<path d="'+fb+'" stroke="'+ends+'" stroke-width="1" fill="none" opacity="'+(V.frizz*.7).toFixed(2)+'"/>';}
 var e=pts[pts.length-1];s+='<path d="M'+e[0].toFixed(1)+' '+(e[1]-4)+' l-6 14 M'+e[0].toFixed(1)+' '+(e[1]-4)+' l6 14" stroke="'+ends+'" stroke-width="'+(V.tw*.45).toFixed(1)+'" stroke-linecap="round" fill="none" opacity="'+V.split.toFixed(2)+'"/>';
 s+='</svg>';
 document.getElementById('cq-avatar').innerHTML=s;
 document.getElementById('cq-strand-label').textContent=V.lab>.5?L.cut[Math.round(cl(V.lvl,0,3))]:'';
}
function sparkle(){var svg=document.querySelector('#cq-avatar svg');if(!svg||RM)return;var h='';for(var i=0;i<10;i++){var x=40+rnd(i*13)*120,y=30+rnd(i*7)*120,dl=(rnd(i*3)*.8).toFixed(2);h+='<g transform="translate('+x.toFixed(1)+' '+y.toFixed(1)+')" opacity="0"><path d="M0 -6 L1.5 -1.5 L6 0 L1.5 1.5 L0 6 L-1.5 1.5 L-6 0 L-1.5 -1.5Z" fill="#b3202a"/><animate attributeName="opacity" values="0;1;0" dur="1.2s" begin="'+dl+'s" fill="freeze"/><animateTransform attributeName="transform" type="scale" additive="sum" values=".2;1.2;.4" dur="1.2s" begin="'+dl+'s" fill="freeze"/></g>';}
 var g=document.createElementNS('http://www.w3.org/2000/svg','g');g.innerHTML=h;svg.appendChild(g);}
function passport(){var ul=document.getElementById('cq-pass'),h='';QS.forEach(function(q){var v=S[q.k];if(!v||(Array.isArray(v)&&!v.length))return;var txt=Array.isArray(v)?v.map(lab).join(', '):lab(v);h+='<li><b>'+esc(L.q[q.k][0])+':</b> '+esc(txt)+'</li>';});ul.innerHTML=h;}
function valid(q){var v=S[q.k];return q.m?Array.isArray(v)&&v.length>0:!!v;}
function pick(q,v){if(q.m){var a=Array.isArray(S[q.k])?S[q.k].slice():[];var i=a.indexOf(v);if(i>-1)a.splice(i,1);else{if(q.x&&v===q.x)a=[];else if(q.x)a=a.filter(function(z){return z!==q.x;});if(q.max&&a.length>=q.max)a.shift();a.push(v);}S[q.k]=a;}else S[q.k]=v;LASTPICK=v;save();render(false);}
var LASTPICK=null;
function render(scroll){var P=document.getElementById('cq-panel');avatar(!!LASTPICK);passport();
 if(step<0){P.innerHTML='<div class="cq-in cq-start"><p>'+esc(L.intro)+'</p><button class="cq-btn acc" id="cq-go">'+esc(L.start)+'</button></div>';document.getElementById('cq-go').onclick=function(){step=0;save();render(true);};return;}
 if(step>=QS.length){summary(P);return;}
 var q=QS[step],pct=Math.round((step)/QS.length*100),h=LASTPICK?'<div>':'<div class="cq-in">';
 h+='<div class="cq-prog"><span>'+esc(L.step)+' '+(step+1)+' '+esc(L.of)+' '+QS.length+'</span><div class="cq-bar"><i style="width:'+pct+'%"></i></div></div>';
 h+='<h3 class="cq-q">'+esc(L.q[q.k][0])+'</h3><p class="cq-qs">'+esc(L.q[q.k][1])+(q.m?' &middot; '+esc(q.max?L.max2:L.multi):'')+'</p><div class="cq-opts">';
 q.o.forEach(function(o){var on=q.m?has(q.k,o):S[q.k]===o;h+='<button type="button" class="cq-opt" data-v="'+o+'" aria-pressed="'+on+'">'+(q.sw?'<span class="cq-sw" style="background:'+HAIR[o]+'"></span>':'')+esc(lab(o))+'</button>';});
 h+='</div><div class="cq-nav"><button class="cq-btn ghost" id="cq-back">'+esc(L.back)+'</button><button class="cq-btn" id="cq-next" '+(valid(q)?'':'disabled')+'>'+esc(step===QS.length-1?L.finish:L.next)+'</button></div></div>';
 P.innerHTML=h;
 if(LASTPICK){var pb=P.querySelector('.cq-opt[data-v="'+LASTPICK+'"]');if(pb)pb.classList.add('pop');LASTPICK=null;}
 P.querySelectorAll('.cq-opt').forEach(function(b){b.onclick=function(){pick(q,b.getAttribute('data-v'));if(!q.m){setTimeout(function(){step++;save();render(true);},220);}};});
 document.getElementById('cq-back').onclick=function(){step--;save();render(true);};
 document.getElementById('cq-next').onclick=function(){if(valid(q)){step++;save();render(true);}};
 if(scroll&&window.innerWidth<820)ROOT.scrollIntoView({behavior:'smooth',block:'start'});
}
function prompt(){var p=L.p,o=[p.hi,'',p.prof];
 ['len','tex','thick','dens','base','col','hist','cond','scalp','wash'].forEach(function(k){var v=S[k];if(!v||(Array.isArray(v)&&!v.length))return;o.push('- '+p.L[k]+': '+(Array.isArray(v)?v.map(lab).join(', '):lab(v)));});
 o.push('');o.push(p.L.goal+': '+(S.goal||[]).map(lab).join(', '));
 o.push(p.L.pref+': '+(S.pref||[]).map(lab).join(', '));
 o.push(p.L.budget+': '+lab(S.budget||'complete'));
 var ln=[];(S.goal||[]).forEach(function(g){if(LINES[g])ln.push(LINES[g]);});if(has('scalp','loss')&&ln.indexOf(LINES.loss)<0)ln.push(LINES.loss);if((has('scalp','oily')||has('scalp','dandruff'))&&ln.indexOf(LINES.scalpbal)<0)ln.push(LINES.scalpbal);
 if(ln.length)o.push(p.L.lines+': '+ln.join('; '));
 o.push('');o.push(p.ask);p.steps.forEach(function(s,i){o.push((i+1)+'. '+s);});
 return o.join('\n');}
function openChat(){var tried=false;
 ['Zipchat','zipchat','ZipChat','zipChat'].forEach(function(n){var z=window[n];if(z&&!tried){['open','show','toggle','expand'].forEach(function(m){if(!tried&&typeof z[m]==='function'){try{z[m]();tried=true;}catch(e){}}});}});
 if(!tried){var sels=[ZIPCHAT_SELECTOR,'#zipchat-launcher','[id*="zipchat"] button','button[id*="zipchat"]','button[class*="zipchat"]','[class*="zipchat"] button','[id*="zipchat"]','[class*="zipchat-launcher"]'];
  for(var i=0;i<sels.length&&!tried;i++){if(!sels[i])continue;var el=document.querySelector(sels[i]);if(el){try{el.click();tried=true;}catch(e){}}}}
 try{window.dispatchEvent(new CustomEvent('zipchat:open'));}catch(e){}
 return tried;}
function summary(P){var txt=prompt(),h='';
 h+='<div class="cq-sum cq-in"><div class="cq-prog"><span>'+esc(L.sumT)+'</span><div class="cq-bar"><i style="width:100%"></i></div></div>';
 h+='<h3>'+esc(L.how)+'</h3><div class="cq-steps"><div><b>1</b>'+esc(L.s1)+'</div><div><b>2</b>'+esc(L.s2)+'</div><div><b>3</b>'+esc(L.s3)+'</div></div>';
 h+='<h3>'+esc(L.promptT)+'</h3><textarea class="cq-prompt" id="cq-txt" readonly>'+esc(txt)+'</textarea>';
 h+='<div class="cq-actions"><button class="cq-btn acc" id="cq-copy">'+esc(L.copy)+'</button><button class="cq-btn" id="cq-open">'+esc(L.open)+'</button><button class="cq-btn ghost" id="cq-restart">'+esc(L.restart)+'</button></div><p class="cq-hint">'+esc(L.hint)+'</p></div>';
 P.innerHTML=h;LASTPICK=null;setTimeout(sparkle,450);
 var cp=document.getElementById('cq-copy');
 function copy(){var ta=document.getElementById('cq-txt');var done=function(){cp.textContent=L.copied;setTimeout(function(){cp.textContent=L.copy;},1800);};if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(ta.value).then(done,function(){ta.select();document.execCommand('copy');done();});}else{ta.select();document.execCommand('copy');done();}}
 cp.onclick=copy;
 document.getElementById('cq-open').onclick=function(){copy();openChat();};
 document.getElementById('cq-restart').onclick=function(){S={};step=0;save();render(true);};
}
['kick','title','sub','ask','ask2'].forEach(function(k){var el=ROOT.querySelector('[data-t="'+k+'"]');if(el)el.textContent=L[k];});
if(step>=0&&step<QS.length)ROOT.querySelector('[data-t="ask"]').textContent=L.cont;
var TG=document.getElementById('cq-toggle');
TG.onclick=function(){var open=!ROOT.classList.contains('open');ROOT.classList.toggle('open',open);ROOT.classList.remove('shown');TG.setAttribute('aria-expanded',open);if(open){setTimeout(function(){if(ROOT.classList.contains('open'))ROOT.classList.add('shown');},600);avatar(true);}};
render(false);
})();
</script>
