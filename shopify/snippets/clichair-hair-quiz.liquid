 o:{fineflat:'Fins et plats',average:'Dans la moyenne',thickfull:'Épais et denses',buzz:'Très courts (pixie)',short:'Courts (aux oreilles)',mid:'Mi-longs (aux épaules)',long:'Longs (sous les épaules)',xlong:'Très longs (milieu du dos ou plus)',straight:'Lisses',wavy:'Ondulés',curly:'Bouclés',coily:'Crépus ou afro',fine:'Fin (on le sent à peine)',medium:'Moyen',thick:'Épais (comme un fil à coudre)',low:'Faible (le cuir chevelu se voit facilement)',high:'Élevée (une queue de cheval épaisse)',black:'Noirs',darkbrown:'Châtain foncé',brown:'Châtain',lightbrown:'Châtain clair',blonde:'Blonds',red:'Roux / cuivrés',grey:'Gris / blancs',natural:'Naturels, jamais colorés',colored:'Colorés, même ton ou plus foncé',greycover:'Colorés pour couvrir les blancs',lightened:'Mèches ou balayage',bleached:'Décolorés sur toute la tête',bleach:'Décoloration ou éclaircissement',keratin:'Kératine ou lissage',perm:'Permanente',heat:'Chaleur 3 fois par semaine ou plus',none:'Aucun de ces traitements',healthy:'Sains, aucun problème',dry:'Secs',frizz:'Frisottis',damaged:'Cassent facilement',split:'Pointes fourchues',dull:'Ternes, sans éclat',normal:'Normal, aucun problème',oily:'Gras, regraisse vite',dryscalp:'Sec, qui tire',dandruff:'Pellicules',sensitive:'Sensible ou démangeaisons',thin:'Cheveux qui s\'éclaircissent',daily:'Tous les jours',alt:'Tous les 2-3 jours',weekly:'Une fois par semaine ou moins',repair:'Réparer et fortifier',hydrate:'Hydratation',smooth:'Anti-frisottis et lissage',curl:'Boucles définies',colorprotect:'Une couleur qui dure',antiyellow:'Pas de reflets jaunes',volume:'Volume et corps',scalpbal:'Un cuir chevelu plus calme et équilibré',loss:'Une chevelure plus dense',shine:'Brillance et douceur',sulfatefree:'Sans sulfates',siliconefree:'Sans silicones',vegan:'Vegan',natorig:'Ingrédients d\'origine naturelle',nopref:'Aucune préférence',essential:'Minimale (2 produits)',complete:'Complète (3-4 produits)',full:'Rituel complet (5 ou plus)'},
